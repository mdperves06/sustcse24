# ─────────────────────────────────────────────────────────────
# CSE 24 — Batch Digital Community · environment variables
# Copy to `.env` for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cse24"

# Separate, disposable database used by `npm test` (it is wiped on every run)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cse24_test"

# Public base URL of the app (used in password-reset emails and ID-card QR codes)
APP_URL="http://localhost:3000"

# bcrypt cost factor (default 12). Keep ≥ 12 in production.
# BCRYPT_ROUNDS=12

# ── File storage ─────────────────────────────────────────────
# "local" stores files on disk (outside /public; served only to signed-in members).
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO…). Keep the bucket PRIVATE.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""                 # e.g. https://<account>.r2.cloudflarestorage.com (omit for AWS)
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"    # "true" for MinIO

# ── Email (password reset) ───────────────────────────────────
# Without SMTP, reset emails are printed to the server console in development
# and skipped (with an error log) in production.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="CSE 24 Community <no-reply@your-domain>"

# ── AI Batch Assistant (optional) ────────────────────────────
# Google Gemini is used when GEMINI_API_KEY is set; otherwise Claude via ANTHROPIC_API_KEY.
# Leave both empty to disable the assistant (the page shows a "not configured" notice).
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-latest"
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5"

# ── Local development database (optional, no Docker needed) ──
# `npm run db:local` starts an embedded PostgreSQL on this port with
# user "cse24" / password "cse24_dev_password" and databases cse24 + cse24_test.
# DEV_DB_PORT=5433
